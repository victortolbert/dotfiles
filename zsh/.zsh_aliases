# ===========================================
# yt-dlp / ffmpeg
# ===========================================
# Best audio as mp3:  yta URL
alias yta='yt-dlp -x --audio-format mp3 --audio-quality 0 -o "%(title)s.%(ext)s"'
# Best audio as wav:  ytw URL
alias ytw='yt-dlp -x --audio-format wav -o "%(title)s.%(ext)s"'
# Best video (mp4):   ytv URL
alias ytv='yt-dlp -f "bv*+ba/b" --merge-output-format mp4 -o "%(title)s.%(ext)s"'
# mp3 + thumbnail + metadata: ytm URL
alias ytm='yt-dlp -x --audio-format mp3 --audio-quality 0 --embed-thumbnail --add-metadata -o "%(title)s.%(ext)s"'
# List available formats:  ytf URL
alias ytf='yt-dlp -F'

# Quick media info:  finfo file
alias finfo='ffprobe -hide_banner'
# Strip audio from video -> mp3:  tomp3 input.mp4
tomp3() { ffmpeg -i "$1" -vn -q:a 0 "${1%.*}.mp3"; }
# Convert any file -> wav:  towav input.m4a
towav() { ffmpeg -i "$1" "${1%.*}.wav"; }
# Lossless trim:  vcut input.mp4 00:00:30 00:01:45 [out.mp4]
vcut() { ffmpeg -i "$1" -ss "$2" -to "$3" -c copy "${4:-${1%.*}_clip.${1##*.}}"; }
# Make a gif:  togif input.mp4 [out.gif]
togif() { ffmpeg -i "$1" -vf "fps=12,scale=480:-1" "${2:-${1%.*}.gif}"; }

# Kill whatever is listening on one or more TCP ports:  killport 3000   |   killport 3000 4321
killport() {
  if [ $# -eq 0 ]; then
    echo "usage: killport <port> [port...]" >&2
    return 1
  fi
  local pids
  pids=$(lsof -t $(for p in "$@"; do printf -- "-itcp:%s " "$p"; done) 2>/dev/null)
  if [ -z "$pids" ]; then
    echo "no process listening on: $*"
    return 0
  fi
  echo "$pids" | xargs kill -9 2>/dev/null
  echo "killed port(s) $*: $(echo $pids | tr '\n' ' ')"
}
