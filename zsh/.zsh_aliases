}

# AEM instance management — RETIRED 2026-09-13, see `aemctl`
#
# `aem-start`, `aem-stop`, `aem-ready`, `aem-status`, `aem-log`, `aem-errors`
# and `_aem_pid` lived here and every one of them silently meant "AEM 6.5 on
# 4502". The AEMaaCS SDK had no equivalents at all, which is why it eventually
# got started with `crx-quickstart/bin/start` — a script that defaults to 4502
# whichever instance directory it sits in — and booted on the 6.5 author's port.
#
# `bin/aemctl` replaces them. Instances are addressed BY NAME and the port is
# derived from the name, never typed:
#
#   aemctl start|stop|restart|ready|status|url|log   author|sdk
#   aemctl doctor      # is each port held by the instance that owns it?
#
#   author  AEM 6.5              4502   ~/aem/author           Java 11
#   sdk     AEM as a Cloud Svc   4602   ~/aem/aemaacs-author   Java 21
#
# Two things the old versions got wrong, kept here because they cost time:
#   - `_aem_pid` matched `ps -o comm=` ending in `*/java`. Under `mise exec` that
#     reports a bare `java`, so the pattern silently found nothing.
#   - `aem-status` grepped `ps -ef` for the 6.5 jar, so it reported "not running"
#     for an SDK that was running perfectly well.


# --- AEM local-dev helpers -------------------------------------------------
# The helpers below (aem-token, aem-check, aem-bundle, aem-pkg, aem-open, …) are
# 6.5 and Maven tooling and are NOT retired. What changed on 2026-09-13 is that
# they no longer hardcode one instance: AEM_INSTANCE names it and `aemctl url`
# derives the port, so pointing them at the SDK is `AEM_INSTANCE=sdk aem-check …`
# rather than editing a literal.
export AEM_INSTANCE="${AEM_INSTANCE:-author}"
# aemctl is the source of truth for the port. The inline fallback repeats the
# same mapping ON PURPOSE: if aemctl is off PATH, a shell must still not hand you
# the other instance's port, which is the whole failure being fixed here.
export AEM_HOST="${AEM_HOST:-$(aemctl url "$AEM_INSTANCE" 2>/dev/null || printf 'http://localhost:%s' "$([ "$AEM_INSTANCE" = sdk ] && echo 4602 || echo 4502)")}"
export AEM_AUTH="${AEM_AUTH:-admin:admin}"
export AEM_CRX="$HOME/aem/$([ "$AEM_INSTANCE" = sdk ] && echo aemaacs-author || echo author)/crx-quickstart"

# live error tail, filtered (Ctrl-C to stop); aem-grep <regex> for a custom pattern
alias aem-tail='tail -f "$AEM_CRX/logs/error.log" | grep -iE "ERROR|Exception|cannot"'
aem-grep() { tail -f "$AEM_CRX/logs/error.log" | grep -iE "$*"; }

# CSRF token for POSTs to /content /apps /etc:  curl ... -H "CSRF-Token: $(aem-token)"
aem-token() { curl -s -u "$AEM_AUTH" "$AEM_HOST/libs/granite/csrf/token.json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["token"])'; }

# render-check a page: aem-check /content/.../page  -> HTTP code + server-error count
aem-check() {
  curl -s -u "$AEM_AUTH" -o /tmp/aem-check.html -w "HTTP %{http_code}  %{size_download}b" "$AEM_HOST$1.html"
  echo "  server-errors: $(grep -ciE 'cannot be resolved|cannot be correctly instantiated|NoClassDefFound|NullPointer|Cannot serve|SightlyException' /tmp/aem-check.html)"
}

# bundle state(s) by symbolic-name substring: aem-bundle common-elements
aem-bundle() {
  curl -s -u "$AEM_AUTH" "$AEM_HOST/system/console/bundles.json" | python3 -c "
import sys,json,re
q=re.compile(r'$1', re.I)
for b in json.load(sys.stdin).get('data', []):
    sn=b.get('symbolicName') or ''
    if q.search(sn): print('{:10} {:>4}  {} {}'.format(b.get('state'), b.get('id'), sn, b.get('version')))
"
}

# deploy an OSGi bundle jar via Felix (installs + starts): aem-deploy-bundle target/foo.jar
aem-deploy-bundle() {
  curl -s -u "$AEM_AUTH" -F action=install -F start=start -F bundlestartlevel=20 -F refreshPackages=true \
    -F bundlefile=@"$1" "$AEM_HOST/system/console/bundles" -o /dev/null -w "deploy %{http_code}  (verify: aem-bundle <name>)\n"
}

# install a FileVault content package (.zip) via Package Manager: aem-pkg path/to.zip
aem-pkg() {
  curl -s -u "$AEM_AUTH" -F file=@"$1" -F name="$(basename "$1" .zip)" -F force=true -F install=true \
    "$AEM_HOST/crx/packmgr/service.jsp" | tr '>' '>\n' | grep -iE "<status code|Package installed" | head -3
}

# open UIs
alias aem-open='open "$AEM_HOST/"'
alias aem-console='open "$AEM_HOST/system/console/bundles"'
alias aem-crxde='open "$AEM_HOST/crx/de/index.jsp"'

# Ivy common-elements: build + deploy the core bundle (JDK 8 via mise), then live-sync ui.apps
aem-build-core() {
  ( cd ~/Projects/ivy && mise exec -- mvn -B -ntp clean install -pl common-elements-aem-parent/core -am -DskipTests ) \
    && aem-deploy-bundle "$(ls ~/Projects/ivy/common-elements-aem-parent/core/target/common-elements.core-*.jar | head -1)"
}
alias aem-sync='aemsync -t "http://$AEM_AUTH@localhost:4502" -w ~/Projects/ivy/common-elements-aem-parent/ui.apps/src/main/content/jcr_root'

# AEM project archetype (interactive)
alias aem-new='mvn archetype:generate \
  -DarchetypeGroupId=com.adobe.aem \
  -DarchetypeArtifactId=aem-project-archetype \
  -DarchetypeVersion=37 \
  -DaemVersion=6.5.0'

# Full AEM project creation
aem-create() {
  local name=${1:-myproject}
  local group=${2:-com.mycompany}
  local title=${3:-"My Project"}

  mvn archetype:generate \
    -DarchetypeGroupId=com.adobe.aem \
    -DarchetypeArtifactId=aem-project-archetype \
    -DarchetypeVersion=37 \
    -DaemVersion=6.5.0 \
    -DgroupId="$group" \
    -DartifactId="$name" \
    -Dversion=1.0.0-SNAPSHOT \
    -Dpackage="$group.$name" \
    -DappsFolderName="$name" \
    -DcontentFolderName="$name" \
    -DcssId="$name" \
    -DcomponentGroupName="$title" \
    -DartifactName="$title" \
    -DappTitle="$title"
}

# AEM React SPA project
aem-create-spa() {
  local name=${1:-myaemreact}
  local group=${2:-com.mycompany}
  local title=${3:-"My AEM React Project"}

  mvn archetype:generate \
    -DarchetypeGroupId=com.adobe.aem \
    -DarchetypeArtifactId=aem-project-archetype \
    -DarchetypeVersion=37 \
    -DaemVersion=6.5.14 \
    -DgroupId="$group" \
    -DartifactId="$name" \
    -Dversion=1.0.0-SNAPSHOT \
    -DappTitle="$title" \
    -DappId="$name" \
    -DoptionSPA=y \
    -DfrontendModule=react \
    -DincludeExamples=n
}

