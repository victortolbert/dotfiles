alias nuxt-dev='rm -rf .nuxt .data .output pnpm-lock.yaml && bun install && bun dev'
alias nuxt-lint='rm -rf .nuxt .data .output pnpm-lock.yaml && bun install && bun lint'
alias nuxt-test='rm -rf .nuxt .data .output pnpm-lock.yaml && bun install && bun run test'
alias nuxt-check='rm -rf .nuxt .data .output pnpm-lock.yaml && bun install && bun typecheck'

# ===========================================
# Java / AEM
# ===========================================
# JDKs here are mise-managed, so they are not registered with macOS and
# /usr/libexec/java_home cannot see them — it returned empty, which silently
# blanked JAVA_HOME. Resolve through mise instead. Accepts a bare major version
# (11) or a full mise version string; `mise where` only prefix-matches some
# names (java@21 resolves, java@11 does not), so fall back to scanning the list.
# Note: mise re-applies the per-directory version on `cd`, so a project with its
# own mise.toml (~/Projects/ivy pins Java 8) still wins inside that tree.
_use_java() {
  local want="$1" home ver
  # `command grep` on purpose: the grep alias below adds -n, which would prefix
  # every match with a line number and corrupt both the version and PATH.
  home="$(mise where "java@$want" 2>/dev/null)"
  if [ -z "$home" ]; then
    ver="$(mise ls java 2>/dev/null | awk '{print $2}' | command grep -E "^(zulu-)?${want}[.-]" | head -1)"
    [ -n "$ver" ] && home="$(mise where "java@$ver" 2>/dev/null)"
  fi
  if [ -z "$home" ]; then
    echo "java $want not installed. Installed:" >&2
    mise ls java 2>/dev/null | awk '{print "  " $2}' >&2
    echo "install with: mise install java@$want" >&2
    return 1
  fi
  # drop any previously injected mise JDK bin dir so repeated calls don't stack
  PATH="$(printf '%s' "$PATH" | tr ':' '\n' | command grep -v '/mise/installs/java/' | paste -sd: -)"
  export JAVA_HOME="$home"
  export PATH="$JAVA_HOME/bin:$PATH"
  java -version
}
alias java8='_use_java 8'
alias java11='_use_java 11'
alias java17='_use_java 17'
alias java21='_use_java 21'
alias jv='java -version'

# AEM UI Build (PHP dev server — root at ~/Projects/ivy so /admp-ivy/... paths resolve via symlink)
