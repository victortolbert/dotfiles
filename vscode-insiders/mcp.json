{
	"servers": {
		"figma": {
			"url": "https://mcp.figma.com/mcp",
			"type": "http"
		},
		"figma-desktop": {
			"url": "http://127.0.0.1:3845/sse",
			"type": "http"
		},
		"wallaby": {
			"command": "npx",
			"args": [
				"-y",
				"-c",
				"node ~/.wallaby/mcp/"
			],
			"type": "stdio"
		},
		"microsoft/markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"markitdown-mcp@0.0.1a4"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		}
	},
	"inputs": []
}